@page "/analytics"
@using DevJournal.Services
@inject JournalEntryService JournalService

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">Analytics</h2>
            <p class="text-muted">Insights into your journaling patterns</p>
        </div>
        
        <!-- Date Range Filter -->
        <div class="d-flex align-items-center">
            <span class="text-muted me-2 small fw-bold text-uppercase">Date Range</span>
            <select class="form-select w-auto bg-white border-0 shadow-sm" @bind="DateFilter" @bind:after="ApplyFilter">
                <option value="All">All Time</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
                <option value="365">Last Year</option>
            </select>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Analyzing your data...</p>
        </div>
    }
    else
    {
        <!-- First Row: Mood Distribution & Stats -->
        <div class="row g-4 mb-4">
            
            <!-- Use Tags (Left Panel 1) -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted fw-bold text-uppercase mb-3">Most Used Tags</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @if (TopTags.Any())
                            {
                                @foreach (var tag in TopTags)
                                {
                                    <span class="badge bg-light text-dark border p-2 fw-normal">
                                        @tag.Key <span class="text-muted ms-1">@tag.Value</span>
                                    </span>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No tags used yet.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mood Distribution (Center Panel) -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-4">
                            <h6 class="text-muted fw-bold text-uppercase">Mood Distribution</h6>
                            <span class="badge bg-primary rounded-pill">@TotalEntries Entries</span>
                        </div>

                        <!-- Positive -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Positive</span>
                                <span>@PositiveCount entries (@PositivePct%)</span>
                            </div>
                            <div class="progress" style="height: 24px; border-radius: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @PositivePct%;"></div>
                            </div>
                        </div>

                        <!-- Neutral -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Neutral</span>
                                <span>@NeutralCount entries (@NeutralPct%)</span>
                            </div>
                            <div class="progress" style="height: 24px; border-radius: 6px;">
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: @NeutralPct%;"></div>
                            </div>
                        </div>

                        <!-- Negative -->
                        <div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Negative</span>
                                <span>@NegativeCount entries (@NegativePct%)</span>
                            </div>
                            <div class="progress" style="height: 24px; border-radius: 6px;">
                                <div class="progress-bar bg-dark" role="progressbar" style="width: @NegativePct%;"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Total Stats (Right Panel 1) -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                     <div class="card-body d-flex flex-column justify-content-center text-center">
                        <h6 class="text-muted fw-bold text-uppercase">Total Entries</h6>
                        <h1 class="display-3 fw-bold text-primary mb-0">@TotalEntries</h1>
                        <p class="text-muted small">records found</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Second Row: Word Count Trends & Frequent Moods -->
        <div class="row g-4">
            
            <!-- Word Count Trends (Left/Center) -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted fw-bold text-uppercase mb-3">Word Count Trends</h6>
                        
                        <!-- Simple SVG Line Chart Placeholder -->
                        <div class="d-flex align-items-end" style="height: 200px; gap: 5px;">
                            @if (WordCounts.Any())
                            {
                                var maxWord = WordCounts.Max();
                                foreach (var count in WordCounts)
                                {
                                    var h = maxWord > 0 ? (count * 100 / maxWord) : 0;
                                    <div class="bg-soft-blue flex-fill rounded-top" 
                                         style="height: @(h)%; min-height: 2px;" 
                                         title="@count words"></div>
                                }
                            }
                            else
                            {
                                <div class="w-100 text-center text-muted align-self-center">No data to display</div>
                            }
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-2">
                            <span>Oldest</span>
                            <span>Newest</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Most Frequent Moods (Right) -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted fw-bold text-uppercase mb-3">Most Frequent Moods</h6>
                        
                        @foreach(var mood in TopMoods)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@mood.Key</span>
                                    <span class="fw-bold">@mood.Value</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-dark" style="width: @(TotalEntries > 0 ? (mood.Value * 100 / TotalEntries) : 0)%"></div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    }
</div>

<style>
    .bg-soft-blue {
        background-color: #e3f2fd;
    }
    .progress-bar {
        transition: width 0.6s ease;
    }
</style>

@code {
    private bool IsLoading = true;
    private string DateFilter = "All";
    
    private List<JournalEntry> AllEntries = new();
    private List<JournalEntry> FilteredEntries = new();
    
    // Stats
    private int TotalEntries = 0;
    
    private int PositiveCount = 0;
    private int NeutralCount = 0;
    private int NegativeCount = 0;
    
    private int PositivePct => TotalEntries > 0 ? (PositiveCount * 100 / TotalEntries) : 0;
    private int NeutralPct => TotalEntries > 0 ? (NeutralCount * 100 / TotalEntries) : 0;
    private int NegativePct => TotalEntries > 0 ? (NegativeCount * 100 / TotalEntries) : 0;

    private Dictionary<string, int> TopTags = new();
    private Dictionary<string, int> TopMoods = new();
    private List<int> WordCounts = new();

    // Sentiment Mapping
    private readonly string[] PositiveMoods = { "😊 Happy", "🤩 Excited", "😌 Relaxed", "🙏 Grateful", "😎 Confident" };
    private readonly string[] NeutralMoods = { "😐 Calm", "🤔 Thoughtful", "🧐 Curious", "🍂 Nostalgic", "😶 Bored" };
    private readonly string[] NegativeMoods = { "😔 Sad", "😠 Angry", "😫 Stressed", "🥺 Lonely", "😟 Anxious" };

    protected override async Task OnInitializedAsync()
    {
        AllEntries = await JournalService.GetAllEntriesAsync();
        ApplyFilter();
        IsLoading = false;
    }

    private void ApplyFilter()
    {
        var now = DateTime.Now;
        FilteredEntries = DateFilter switch
        {
            "7" => AllEntries.Where(e => e.Date >= now.AddDays(-7)).ToList(),
            "30" => AllEntries.Where(e => e.Date >= now.AddDays(-30)).ToList(),
            "365" => AllEntries.Where(e => e.Date >= now.AddDays(-365)).ToList(),
            _ => AllEntries.ToList()
        };

        CalculateStats();
    }

    private void CalculateStats()
    {
        TotalEntries = FilteredEntries.Count;

        // Sentiment
        PositiveCount = FilteredEntries.Count(e => PositiveMoods.Contains(e.PrimaryMood));
        NeutralCount = FilteredEntries.Count(e => NeutralMoods.Contains(e.PrimaryMood));
        NegativeCount = FilteredEntries.Count(e => NegativeMoods.Contains(e.PrimaryMood));

        // Top Tags
        var allTags = FilteredEntries.Where(e => !string.IsNullOrEmpty(e.Tags))
                                     .SelectMany(e => (e.Tags ?? "").Split(','))
                                     .Select(t => t.Trim())
                                     .Where(t => !string.IsNullOrEmpty(t));
        TopTags = allTags.GroupBy(t => t)
                         .OrderByDescending(g => g.Count())
                         .Take(8)
                         .ToDictionary(g => g.Key, g => g.Count());

        // Frequent Moods
        TopMoods = FilteredEntries.GroupBy(e => e.PrimaryMood)
                                  .OrderByDescending(g => g.Count())
                                  .Take(5)
                                  .ToDictionary(g => g.Key, g => g.Count());

        // Word Counts (Trend) - Simple approximate word count
        WordCounts = FilteredEntries.OrderBy(e => e.Date)
                                    .Select(e => e.Content?.Split(new[]{' ', '<', '>'}, StringSplitOptions.RemoveEmptyEntries).Length ?? 0)
                                    .ToList();
        
        // Downsample for chart if too many points?
        // For simple bar viz, just take last 20 or so if massive
        if (WordCounts.Count > 30)
        {
            // Simple logic: take last 30
           WordCounts = WordCounts.TakeLast(30).ToList();
        }
    }
}
