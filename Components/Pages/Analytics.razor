@page "/analytics"
@using DevJournal.Services
@inject JournalEntryService JournalService

<div class="container-fluid mt-4 fade-in">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-sky-blue">Analytics Dashboard </h2>
            <p class="text-muted mb-0">Overview of your journaling journey</p>
        </div>

        <!-- Date Range Filter -->
        <div>
            <select class="form-select bg-white border-0 shadow-sm" style="min-width: 150px;" @bind="DateFilter"
                @bind:after="ApplyFilter">
                <option value="30">Last 30 Days</option>
                <option value="7">Last 7 Days</option>
                <option value="90">Last 3 Months</option>
                <option value="365">Last Year</option>
                <option value="All">All Time</option>
            </select>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Crunching the numbers...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">

            <!-- Streak Card -->
            <div class="col-md-5 col-lg-4">
                <div class="card border-0 shadow-sm h-100 text-white overflow-hidden"
                    style="background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);">
                    <div class="card-body text-center d-flex flex-column justify-content-center p-4">
                        <h6 class="text-white-50 text-uppercase fw-bold mb-3">Current Streak</h6>
                        <div class="mb-2">
                            <span class="display-1 fw-bold">🔥 @CurrentStreak</span>
                        </div>
                        <p class="mb-3 opacity-75">consecutive days</p>
                        <div class="badge bg-white text-danger px-3 py-2 rounded-pill align-self-center">
                            Longest: <strong>@LongestStreak days</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filtered Entries Count -->
            <div class="col-md-3 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted text-uppercase fw-bold mb-3">Filtered Entries</h6>
                        <h2 class="display-3 fw-bold text-primary mb-0">@FilteredEntries.Count</h2>
                        <p class="text-muted small">entries in this period</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted text-uppercase fw-bold mb-3">Total Words</h6>
                        <h2 class="display-3 fw-bold text-info mb-0">@TotalWords</h2>
                        <p class="text-muted small">words written</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4 mb-4">

            <!-- Most Frequent Mood -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted fw-bold text-uppercase mb-4">Most Frequent Mood</h6>

                        @if (!string.IsNullOrEmpty(TopMoodName))
                        {
                            <div class="text-center py-4">
                                <div style="font-size: 5rem;" class="mb-2">@TopMoodEmoji</div>
                                <h3 class="fw-bold text-dark">@TopMoodName</h3>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                No mood data available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Mood Distribution Chart -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted fw-bold text-uppercase mb-4">Mood Distribution</h6>

                        <div class="d-flex align-items-center justify-content-center gap-5 flex-wrap">
                            <!-- CSS Pie/Donut Chart -->
                            <div class="pie-chart" style="background: @GetPieGradient();">
                                <div class="pie-hole"></div>
                            </div>

                            <!-- Legend -->
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="legend-dot bg-success"></span>
                                    <span>Positive (@PositivePct%)</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="legend-dot bg-secondary"></span>
                                    <span>Neutral (@NeutralPct%)</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="legend-dot bg-danger"></span>
                                    <span>Negative (@NegativePct%)</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Tags & Missed Days -->
        <div class="row g-4 mb-5">

            <!-- Tag Breakdown -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted fw-bold text-uppercase mb-4">Tag Breakdown</h6>

                        <div class="d-flex flex-column gap-3">
                            @if (TopTags.Any())
                            {
                                @foreach (var tag in TopTags)
                                {
                                    /* Calculate width relative to max */
                                    var max = TopTags.First().Value;
                                    var width = (double)tag.Value / max * 100;

                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-dark fw-medium" style="min-width: 100px;">@tag.Key</span>
                                        <div class="progress flex-grow-1 mx-3"
                                            style="height: 6px; background-color: var(--border-color);">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @width%"></div>
                                        </div>
                                        <span class="badge bg-primary rounded-pill">@tag.Value</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No tags found.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Missed Days -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted fw-bold text-uppercase mb-4">Recent Missed Days</h6>

                        @if (MissedDates.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var date in MissedDates.Take(12))
                                {
                                    <div class="badge bg-light text-muted border fw-normal px-3 py-2">
                                        @date.ToString("MMM dd")
                                    </div>
                                }
                                @if (MissedDates.Count > 12)
                                {
                                    <div class="badge bg-light text-muted border fw-normal px-3 py-2">
                                        ...and @(MissedDates.Count - 12) more
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-success">
                                <h5>🎉 Amazing!</h5>
                                <p>You haven't missed any days in this period.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }
</div>

<style>
    .fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .pie-chart {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pie-hole {
        width: 120px;
        height: 120px;
        background-color: var(--card-bg);
        border-radius: 50%;
        position: absolute;
        transition: background-color 0.3s ease;
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }

    .bg-success {
        background-color: #10B981 !important;
    }

    .bg-secondary {
        background-color: #9CA3AF !important;
    }

    /* Neutral grey */
    .bg-danger {
        background-color: #EF4444 !important;
    }
</style>

@code {
    private bool IsLoading = true;
    private string DateFilter = "30"; // Default to 30 days

    private List<JournalEntry> AllEntries = new();
    private List<JournalEntry> FilteredEntries = new();

    // KPIs
    private int CurrentStreak = 0;
    private int LongestStreak = 0;
    private int TotalWords = 0;

    // Moods
    private string TopMoodEmoji = "😐";
    private string TopMoodName = "";

    private int PositiveCount = 0;
    private int NeutralCount = 0;
    private int NegativeCount = 0;
    private int TotalFiltered => FilteredEntries.Count;

    private int PositivePct => TotalFiltered > 0 ? (PositiveCount * 100 / TotalFiltered) : 0;
    private int NeutralPct => TotalFiltered > 0 ? (NeutralCount * 100 / TotalFiltered) : 0;
    private int NegativePct => TotalFiltered > 0 ? (NegativeCount * 100 / TotalFiltered) : 0;

    private Dictionary<string, int> TopTags = new();
    private List<DateTime> MissedDates = new();

    // Sentiment Mapping
    private readonly string[] PositiveMoods = { "😊 Happy", "🤩 Excited", "😌 Relaxed", "🙏 Grateful", "😎 Confident" };
    private readonly string[] NeutralMoods = { "😐 Calm", "🤔 Thoughtful", "🧐 Curious", "🍂 Nostalgic", "😶 Bored" };
    private readonly string[] NegativeMoods = { "😔 Sad", "😠 Angry", "😫 Stressed", "🥺 Lonely", "😟 Anxious" };

    protected override async Task OnInitializedAsync()
    {
        // Load all data once
        AllEntries = await JournalService.GetAllEntriesAsync();
        ApplyFilter();

        // Calculate All-Time Streak
        CalculateLongestStreak(AllEntries);
        CalculateCurrentStreak(AllEntries);

        IsLoading = false;
    }

    private void ApplyFilter()
    {
        var now = DateTime.Now.Date;
        DateTime startDate = DateFilter switch
        {
            "7" => now.AddDays(-7),
            "30" => now.AddDays(-30),
            "90" => now.AddDays(-90),
            "365" => now.AddDays(-365),
            _ => DateTime.MinValue
        };

        if (DateFilter == "All")
        {
            FilteredEntries = AllEntries.ToList();
        }
        else
        {
            FilteredEntries = AllEntries.Where(e => e.Date.Date >= startDate && e.Date.Date <= now).ToList();
        }

        CalculateStats(startDate, now);
    }

    private string GetPieGradient()
    {

        int posEnd = PositivePct;
        int neuEnd = posEnd + NeutralPct;

        return $"conic-gradient(#10B981 0% {posEnd}%, #9CA3AF {posEnd}% {neuEnd}%, #EF4444 {neuEnd}% 100%)";
    }

    private void CalculateStats(DateTime start, DateTime end)
    {
        // Word Count
        TotalWords = FilteredEntries.Sum(e => e.Content?.Split(new[] { ' ', '<', '>' },
        StringSplitOptions.RemoveEmptyEntries).Length ?? 0);

        // Mood Distribution
        PositiveCount = FilteredEntries.Count(e => PositiveMoods.Contains(e.PrimaryMood));
        NeutralCount = FilteredEntries.Count(e => NeutralMoods.Contains(e.PrimaryMood));
        NegativeCount = FilteredEntries.Count(e => NegativeMoods.Contains(e.PrimaryMood));

        // Top Mood
        var moodGroups = FilteredEntries.GroupBy(e => e.PrimaryMood).OrderByDescending(g => g.Count()).FirstOrDefault();
        if (moodGroups != null)
        {
            var parts = moodGroups.Key.Split(' ');
            if (parts.Length > 1)
            {
                TopMoodEmoji = parts[0];
                TopMoodName = string.Join(" ", parts.Skip(1));
            }
            else
            {
                TopMoodEmoji = "❓";
                TopMoodName = parts[0];
            }
        }
        else
        {
            TopMoodEmoji = "📭";
            TopMoodName = "No entries";
        }

        var allTags = FilteredEntries.Where(e => !string.IsNullOrEmpty(e.Tags))
        .SelectMany(e => (e.Tags ?? "").Split(','))
        .Select(t => t.Trim())
        .Where(t => !string.IsNullOrEmpty(t));
        TopTags = allTags.GroupBy(t => t)
        .OrderByDescending(g => g.Count())
        .Take(5)
        .ToDictionary(g => g.Key, g => g.Count());

        MissedDates.Clear();
        if (DateFilter != "All")
        {
            var entryDates = new HashSet<DateTime>(FilteredEntries.Select(e => e.Date.Date));
            for (var d = start; d <= end; d = d.AddDays(1))
            {
                if (!entryDates.Contains(d))
                {
                    MissedDates.Add(d);
                }
            }

            MissedDates = MissedDates.OrderByDescending(d => d).ToList();
        }
    }

    private void CalculateCurrentStreak(List<JournalEntry> entries)
    {
        if (!entries.Any())
        {
            CurrentStreak = 0;
            return;
        }

        var dates = entries.Select(e => e.Date.Date).Distinct().OrderByDescending(d => d).ToList();
        var today = DateTime.Now.Date;

        if (dates.First() < today.AddDays(-1))
        {
            CurrentStreak = 0;
            return;
        }

        int streak = 0;
        var checkDate = dates.First() == today ? today : today.AddDays(-1);

        foreach (var d in dates)
        {
            if (d == checkDate)
            {
                streak++;
                checkDate = checkDate.AddDays(-1);
            }
            else if (d > checkDate)
            {
                continue;
            }
            else
            {
                break;
            }
        }
        CurrentStreak = streak;
    }

    private void CalculateLongestStreak(List<JournalEntry> entries)
    {
        if (!entries.Any())
        {
            LongestStreak = 0;
            return;
        }

        var dates = entries.Select(e => e.Date.Date).Distinct().OrderBy(d => d).ToList();

        int maxStreak = 0;
        int currentRun = 0;
        DateTime? lastDate = null;

        foreach (var d in dates)
        {
            if (lastDate == null)
            {
                currentRun = 1;
                lastDate = d;
                continue;
            }

            if (d == lastDate.Value.AddDays(1))
            {
                currentRun++;
            }
            else
            {
                if (currentRun > maxStreak) maxStreak = currentRun;
                currentRun = 1;
            }
            lastDate = d;
        }

        if (currentRun > maxStreak) maxStreak = currentRun;

        LongestStreak = maxStreak;
    }
}