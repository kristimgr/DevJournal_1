@page "/new-entry"
@using DevJournal
@using DevJournal.Services
@inject JournalEntryService JournalService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container-fluid mt-4">
    <div class="col-lg-9 col-md-10">

        <h2 class="fw-bold">New Entry</h2>
        <p class="text-muted">Capture your thoughts and feelings</p>

        <div class="alert alert-light border">
            Only one journal entry is allowed per day
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <!-- Date -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Date</label>
                    <input class="form-control" value="@TodayFormatted" disabled />
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select class="form-select" @bind="Category">
                        <option value="" disabled selected>Select a Category...</option>
                        @foreach (var cat in PredefinedCategories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Title</label>
                    <input class="form-control" @bind="Title" placeholder="Give your day a headline..." />
                </div>

                <!-- Content (QuillJS) -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Content</label>
                    <div id="quill-editor" style="height: 300px;"></div>
                </div>

                <!-- Primary Mood -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Primary Mood (Select One)</label>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var mood in AllMoods)
                        {
                            <button type="button"
                                    class="badge px-3 py-2 rounded-pill border-0
                                    @(PrimaryMood == mood
                                        ? "bg-primary text-white shadow"
                                        : "bg-light text-dark border")"
                                    @onclick="() => SelectPrimaryMood(mood)">
                                @mood
                            </button>
                        }
                    </div>
                </div>

                <!-- Secondary Moods -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Secondary Moods (Max 2)</label>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var mood in AllMoods)
                        {
                            var isSelected = SecondaryMoodsList.Contains(mood);
                            var isDisabled = !isSelected && SecondaryMoodsList.Count >= 2;

                            <button type="button"
                                    class="badge px-3 py-2 rounded-pill border-0
                                    @(isSelected
                                        ? "bg-info text-dark shadow-sm"
                                        : "bg-light text-muted border")"
                                    disabled="@isDisabled"
                                    @onclick="() => ToggleSecondaryMood(mood)">
                                @mood
                            </button>
                        }
                    </div>
                </div>

                <!-- Tags -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tags</label>
                    <input class="form-control"
                           placeholder="Comma separated tags (e.g. Work, Health)"
                           @bind="Tags" />
                    <div class="form-text">Common tags: Work, Health, Travel, Family</div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-primary px-4"
                            @onclick="SaveEntry">
                        💾 Save Entry
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            @onclick="Cancel">
                        Cancel
                    </button>
                </div>

                @if (ShowSuccess)
                {
                    <div class="alert alert-success mt-3">
                        ✅ Entry saved successfully!
                    </div>
                }

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger mt-3">
                        @Error
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {

    private string Title = string.Empty;
    private string PrimaryMood = string.Empty;
    private string Category = string.Empty;
    private string Tags = string.Empty;
    private string Error = string.Empty;



    private List<string> SecondaryMoodsList = new();

    private bool ShowSuccess = false;

    private DateTime Today = DateTime.Today;

    private string TodayFormatted =>
        Today.ToString("dddd, MMMM dd, yyyy");

    private List<string> AllMoods = new()
    {
        "😊 Happy", "🤩 Excited", "😌 Relaxed", "🙏 Grateful", "😎 Confident", 
        "😐 Calm", "🤔 Thoughtful", "🧐 Curious", "🍂 Nostalgic", "😶 Bored", 
        "😔 Sad", "😠 Angry", "😫 Stressed", "🥺 Lonely", "😟 Anxious" 
    };

    private List<string> PredefinedCategories = new()
    {
        "Personal", "Work", "relationships", "Health", "Travel", "Finance", "Education", "Spirituality"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("QuillFunctions.createQuill", 
                await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "quill-editor"));
        }
    }

    private void SelectPrimaryMood(string mood)
    {
        PrimaryMood = mood;
        if (SecondaryMoodsList.Contains(mood))
        {
            SecondaryMoodsList.Remove(mood);
        }
    }

    private void ToggleSecondaryMood(string mood)
    {
        if (PrimaryMood == mood) return; 

        if (SecondaryMoodsList.Contains(mood))
        {
            SecondaryMoodsList.Remove(mood);
        }
        else
        {
            if (SecondaryMoodsList.Count < 2)
            {
                SecondaryMoodsList.Add(mood);
            }
        }
    }

    private async Task SaveEntry()
    {
        Error = string.Empty;
        ShowSuccess = false;

        // Get content from Quill
        var content = await JS.InvokeAsync<string>("QuillFunctions.getQuillContent", 
             await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "quill-editor"));

        // Basic validation check (Quill often returns <p><br></p> for empty)
        if (string.IsNullOrWhiteSpace(Title) ||
            string.IsNullOrWhiteSpace(content) || content == "<p><br></p>" ||
            string.IsNullOrWhiteSpace(PrimaryMood) ||
            string.IsNullOrWhiteSpace(Category))
        {
            Error = "Title, Content, Primary Mood, and Category are required.";
            StateHasChanged();
            return;
        }

        try
        {
            var existing = await JournalService.GetEntryByDateAsync(Today);
            if (existing != null)
            {
                Error = "You already have an entry for today.";
                StateHasChanged();
                return;
            }

            var entry = new JournalEntry
            {
                Date = Today.Date,
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now,
                Title = Title,
                Content = content, // Saving HTML
                PrimaryMood = PrimaryMood,
                Category = Category,
                SecondaryMoods = string.Join(",", SecondaryMoodsList),
                Tags = Tags
            };

            await JournalService.AddEntryAsync(entry);

            ShowSuccess = true;
        }
        catch (Exception ex)
        {
            Error = $"Unable to save entry: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task Cancel()
    {
        Navigation.NavigateTo("/");
        await Task.CompletedTask;
    }
}
