@page "/new-entry"
@using DevJournal
@using DevJournal.Services
@inject JournalEntryService JournalService
@inject NavigationManager Navigation


<div class="container-fluid mt-4">
    <div class="col-lg-9 col-md-10">

        <h2 class="fw-bold">New Entry</h2>
        <p class="text-muted">Capture your thoughts and feelings</p>

        <div class="alert alert-light border">
            Only one journal entry is allowed per day
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <!-- Date -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Date</label>
                    <input class="form-control" value="@TodayFormatted" disabled />
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Title</label>
                    <input class="form-control" @bind="Title" />
                </div>

                <!-- Content -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Content</label>
                    <textarea class="form-control" rows="6" @bind="Content"></textarea>
                </div>

                <!-- Primary Mood -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Primary Mood</label>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var mood in Moods)
                        {
                            <button type="button"
                                    class="badge px-3 py-2 rounded-pill
                                    @(PrimaryMood == mood
                                        ? "bg-dark text-white"
                                        : "bg-light text-dark border")"
                                    @onclick="() => SelectMood(mood)">
                                @mood
                            </button>
                        }
                    </div>
                </div>

                <!-- Tags -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tags</label>
                    <input class="form-control"
                           placeholder="Comma separated tags"
                           @bind="Tags" />
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-dark px-4"
                            @onclick="SaveEntry">
                        💾 Save Entry
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            @onclick="Cancel">
                        Cancel
                    </button>
                </div>

                @if (ShowSuccess)
                {
                    <div class="alert alert-success mt-3">
                        ✅ Entry saved successfully!
                    </div>
                }

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger mt-3">
                        @Error
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {

    private string Title = string.Empty;
    private string Content = string.Empty;
    private string PrimaryMood = string.Empty;
    private string Tags = string.Empty;
    private string Error = string.Empty;

    private bool ShowSuccess = false;

    private DateTime Today = DateTime.Today;

    private string TodayFormatted =>
        Today.ToString("dddd, MMMM dd, yyyy");

    private List<string> Moods = new()
    {
        "😊 Happy",
        "😔 Sad",
        "😟 Anxious",
        "😌 Calm",
        "🤩 Excited",
        "😤 Frustrated",
        "🙏 Grateful",
        "😐 Neutral"
    };

    private void SelectMood(string mood)
    {
        PrimaryMood = mood;
        Error = string.Empty;
    }

    private async Task SaveEntry()
    {
        Error = string.Empty;
        ShowSuccess = false;

        if (string.IsNullOrWhiteSpace(Title) ||
            string.IsNullOrWhiteSpace(Content) ||
            string.IsNullOrWhiteSpace(PrimaryMood))
        {
            Error = "All required fields must be filled.";
            StateHasChanged();
            return;
        }

        var existing = await JournalService.GetEntryByDateAsync(Today);
        if (existing != null)
        {
            Error = "You already have an entry for today.";
            StateHasChanged();
            return;
        }

        var entry = new JournalEntry
        {
            Date = Today.Date,
            Title = Title,
            Content = Content,
            PrimaryMood = PrimaryMood,
            Tags = Tags
        };

        await JournalService.AddEntryAsync(entry);

        ShowSuccess = true;
        StateHasChanged();
    }

    private async Task Cancel()
    {
        Navigation.NavigateTo("/");
        await Task.CompletedTask;
    }
}
