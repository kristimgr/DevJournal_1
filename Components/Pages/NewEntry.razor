@page "/new-entry"

<div class="new-entry">

    <!-- Header -->
    <div class="entry-header">
        <h1>New Entry</h1>
        <p>Capture your thoughts and feelings</p>
    </div>

    <!-- Info box -->
    <div class="info-box">
        ⓘ Only one journal entry is allowed per day
    </div>

    <!-- Form -->
    <div class="entry-form">

        <!-- Date -->
        <div class="form-group">
            <label>Date</label>
            <input type="text" value="Wednesday, January 07, 2026" disabled />
        </div>

        <!-- Title -->
        <div class="form-group">
            <label>Title</label>
            <input type="text" placeholder="Enter title" />
        </div>

        <!-- Content -->
        <div class="form-group">
            <label>Content</label>
            <textarea rows="6" placeholder="Write your journal here..."></textarea>
        </div>

        <!-- Primary Mood -->
        <div class="form-group">
            <label>Primary Mood *</label>
            <div class="chip-group">
                <span class="chip active">😊 Happy</span>
                <span class="chip">😔 Sad</span>
                <span class="chip">😟 Anxious</span>
                <span class="chip">😌 Calm</span>
                <span class="chip">🤩 Excited</span>
                <span class="chip">😤 Frustrated</span>
                <span class="chip">🙏 Grateful</span>
                <span class="chip">😐 Neutral</span>
            </div>
        </div>

        <!-- Secondary Mood -->
        <div class="form-group">
            <label>Secondary Moods (Optional - up to 2)</label>
            <small>2/2 selected</small>

            <div class="chip-group muted">
                <span class="chip active">😊 Happy ✕</span>
                <span class="chip active">😟 Anxious ✕</span>
                <span class="chip">😌 Calm</span>
                <span class="chip">🤩 Excited</span>
                <span class="chip">😤 Frustrated</span>
                <span class="chip">🙏 Grateful</span>
                <span class="chip">😐 Neutral</span>
            </div>
        </div>

        <!-- Tags -->
        <div class="form-group">
            <label>Tags</label>
            <small>Select from built-in tags:</small>

            <div class="chip-group">
                <span class="chip active">Work</span>
                <span class="chip active">Personal</span>
                <span class="chip active">Reflection</span>
                <span class="chip">Achievement</span>
                <span class="chip">Challenge</span>
                <span class="chip">Health</span>
                <span class="chip">Family</span>
                <span class="chip">Hobby</span>
            </div>
        </div>

        <!-- Custom tags -->
        <div class="form-group">
            <label>Add custom tags</label>
            <input type="text" placeholder="Type a tag and press Enter or click Add" />

            <div class="chip-group muted">
                <span class="chip active">Work ✕</span>
                <span class="chip active">Personal ✕</span>
                <span class="chip active">Reflection ✕</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button class="btn primary">💾 Save Entry</button>
            <button class="btn secondary">Cancel</button>
        </div>

    </div>

</div>
