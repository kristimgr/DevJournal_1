@page "/settings"
@inject IJSRuntime JS

<div class="container-fluid mt-4">
    <div class="col-lg-9 col-md-10">

        <h2 class="fw-bold">Settings</h2>
        <p class="text-muted">Manage your preferences</p>

        <div class="card shadow-sm mt-3">
            <div class="card-body">

                <h5 class="fw-semibold mb-3">Appearance</h5>
                <p class="text-muted mb-2">Choose your preferred color scheme</p>

                <!-- Theme Preview -->
                <div class="row g-3">

                    <!-- Light -->
                    <div class="col-md-6">
                        <div class="theme-preview light">
                            ☀ Light Mode
                        </div>
                    </div>

                    <!-- Dark -->
                    <div class="col-md-6">
                        <div class="theme-preview dark">
                            🌙 Dark Mode
                        </div>
                    </div>

                </div>

                <!-- Toggle -->
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           checked="@isDark"
                           @onchange="ToggleTheme" />

                    <label class="form-check-label">
                        Enable Dark Mode
                    </label>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private bool isDark = false;

    private async Task ToggleTheme(ChangeEventArgs e)
    {
        isDark = (bool)e.Value!;

        await JS.InvokeVoidAsync(
            "document.documentElement.setAttribute",
            "data-theme",
            isDark ? "dark" : "light"
        );
    }
}
