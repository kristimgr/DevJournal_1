@page "/settings"
@using DevJournal.Services
@inject JournalEntryService JournalService
@inject IJSRuntime JS
@inject AppState AppState
@implements IDisposable

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-sky-blue">Settings</h2>

    <!-- Appearance -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold">🎨 Appearance</h5>
            <p class="text-muted mb-2">Choose your preferred color scheme</p>

            <div class="form-check form-switch">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       checked="@AppState.IsDark"
                       @onchange="ToggleTheme" />

                <label class="form-check-label">
                    Enable Dark Mode
                </label>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold">🔒 Security</h5>
            <p class="text-muted mb-3">Protect your journal with a 4-digit PIN.</p>

            @if (!AppState.IsPinSet)
            {
                <div class="d-flex align-items-center gap-2">
                    <input type="password" class="form-control w-auto" placeholder="Enter 4-digit PIN" maxlength="4" @bind="NewPin" />
                    <button class="btn btn-success" @onclick="SetPin" disabled="@(NewPin.Length != 4)">Set PIN</button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-success fw-bold">✓ PIN Protection Enabled</span>
                    <button class="btn btn-danger btn-sm" @onclick="RemovePin">Remove PIN</button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold">💾 Export Journal</h5>
            <p class="text-muted">Export your journal entries to PDF.</p>

            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" @bind="StartDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" @bind="EndDate" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-sky-blue w-100" @onclick="ExportPdfAsDownload">
                        Export as PDF
                    </button>
                    <style>
                        .btn-sky-blue {
                            background-color: #4dabf7; /* Sky Blue */
                            border-color: #4dabf7;
                            color: white;
                            transition: all 0.2s ease;
                        }
                        .btn-sky-blue:hover {
                            background-color: #3b8fc2;
                            border-color: #3b8fc2;
                            color: white;
                        }
                        .btn-sky-blue:active {
                            background-color: #a0d1f7 !important; /* Lighter on click */
                            border-color: #a0d1f7 !important;
                        }
                    </style>
                </div>
            </div>
            
             @if (ExportMessage != "")
            {
                <div class="mt-2 text-info">@ExportMessage</div>
            }
        </div>
    </div>
</div>

@code {
    private DateTime StartDate = DateTime.Today.AddMonths(-1);
    private DateTime EndDate = DateTime.Today;
    private string ExportMessage = "";
    
    private string NewPin = "";

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void ToggleTheme(ChangeEventArgs e)
    {
        var isDark = (bool)e.Value!;
        var theme = isDark ? "dark" : "light";
        
        AppState.SetTheme(theme);
        
        JS.InvokeVoidAsync("setTheme", theme);
    }
    
    private async Task SetPin()
    {
        if (NewPin.Length == 4 && int.TryParse(NewPin, out _))
        {
            await AppState.SetPinAsync(NewPin);
            NewPin = "";
        }
    }

    private void RemovePin()
    {
        AppState.RemovePin();
    }

    private async Task ExportPdfAsDownload()
    {
        ExportMessage = "Generating PDF...";
        var filtered = await GetFilteredEntries();

        if (filtered.Any())
        {
            var title = $"Journal Export ({StartDate:d} - {EndDate:d})";
            var html = GenerateHtmlBody(title, filtered); // Send just body, JS will wrap
            
            var filename = $"Journal_Export_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JS.InvokeVoidAsync("downloadPdf", filename, html);
            ExportMessage = "PDF Download started.";
        }
        else
        {
            ExportMessage = "No entries found in this date range.";
        }
    }

    private async Task<List<JournalEntry>> GetFilteredEntries()
    {
        var allEntries = await JournalService.GetAllEntriesAsync();
        return allEntries.Where(e => e.Date >= StartDate && e.Date <= EndDate).OrderBy(e => e.Date).ToList();
    }

    private string GenerateHtml(string title, List<JournalEntry> entries)
    {
        return $"<div class='journal-export'>{GenerateHtmlBody(title, entries)}</div>";
    }

    private string GenerateHtmlBody(string title, List<JournalEntry> entries)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<h1>{title}</h1>");
        sb.Append($"<p class='meta'>Generated on {DateTime.Now:F}</p><hr/>");

        foreach (var entry in entries)
        {
             sb.Append($@"
                <div class='entry'>
                    <h2>{entry.Title}</h2>
                    <p class='meta'>
                        <strong>Date:</strong> {entry.Date:yyyy-MM-dd} | 
                        <strong>Mood:</strong> {entry.PrimaryMood}
                    </p>
                    <div>{entry.Content}</div>
                </div>");
        }
        return sb.ToString();
    }
    
    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
