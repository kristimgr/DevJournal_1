@page "/calendar"
@using DevJournal.Services
@inject JournalEntryService JournalService
@inject NavigationManager Navigation

<div class="container-fluid mt-4">
    <div class="row">
        
        <!-- CALENDAR SIDE -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    
                    <!-- Header / Navigation -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold text-primary m-0">@CurrentDate.ToString("MMMM yyyy")</h3>
                        <div>
                            <button class="btn btn-outline-primary btn-sm rounded-circle" @onclick="PrevMonth">❮</button>
                            <button class="btn btn-outline-primary btn-sm rounded-circle" @onclick="NextMonth">❯</button>
                        </div>
                    </div>

                    <!-- Week Days -->
                    <div class="row text-center mb-2 fw-bold text-muted small">
                        <div class="col">Sun</div>
                        <div class="col">Mon</div>
                        <div class="col">Tue</div>
                        <div class="col">Wed</div>
                        <div class="col">Thu</div>
                        <div class="col">Fri</div>
                        <div class="col">Sat</div>
                    </div>

                    <!-- Days Grid -->
                    <div class="calendar-grid">
                        @for (int i = 0; i < EmptySlots; i++)
                        {
                            <div class="calendar-day empty"></div>
                        }

                        @for (int day = 1; day <= DaysInMonth; day++)
                        {
                            var date = new DateTime(CurrentDate.Year, CurrentDate.Month, day);
                            var hasEntry = EntriesByDate.ContainsKey(date.Date);
                            var isSelected = SelectedDate.Date == date.Date;

                            <div class="calendar-day @(isSelected ? "selected" : "") @(hasEntry ? "has-entry" : "")" 
                                 @onclick="() => SelectDate(date)">
                                
                                <span class="day-number">@day</span>
                                
                                @if (hasEntry)
                                {
                                    <div class="mood-dot" title="@EntriesByDate[date.Date].PrimaryMood"></div>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- PREVIEW SIDE -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-soft-blue">
                <div class="card-body">
                    <h5 class="fw-bold text-primary">@SelectedDate.ToString("D")</h5>
                    <hr/>

                    @if (EntriesByDate.ContainsKey(SelectedDate.Date))
                    {
                        var entry = EntriesByDate[SelectedDate.Date];
                        <h4 class="fw-bold">@entry.Title</h4>
                        <div class="mb-2">
                             <span class="badge bg-white text-primary border">@entry.PrimaryMood</span>
                             @if(!string.IsNullOrEmpty(entry.Category)) {
                                 <span class="badge bg-white text-info border">@entry.Category</span>
                             }
                        </div>
                        <div class="text-muted mb-3" style="max-height: 100px; overflow: hidden; position: relative;">
                            @((MarkupString)(entry.Content ?? ""))
                            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 30px; background: linear-gradient(transparent, #e3f2fd);"></div>
                        </div>
                        <button class="btn btn-sm btn-light text-primary w-100 mt-auto" 
                                @onclick="() => NavigateToEntry(entry.Date)">
                            View Full Entry
                        </button>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <p>No entry for this day.</p>
                            @if (SelectedDate.Date == DateTime.Today)
                            {
                                <a href="/new-entry" class="btn btn-primary rounded-pill px-4">✍ Write Today</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .calendar-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .calendar-day {
        width: 14.28%; /* 100% / 7 */
        height: 100px;
        border: 1px solid #f0f8ff;
        padding: 8px;
        position: relative;
        cursor: pointer;
        transition: all 0.2s;
        border-radius: 8px;
    }
    
    .calendar-day:hover:not(.empty) {
        background-color: #f1f9ff;
    }

    .calendar-day.selected {
        background-color: #e3f2fd;
        border-color: #90caf9;
        font-weight: bold;
    }

    .calendar-day.empty {
        background: transparent;
        cursor: default;
    }

    .has-entry {
        background-color: #fff;
    }

    .mood-dot {
        width: 10px;
        height: 10px;
        background-color: #4dabf7;
        border-radius: 50%;
        position: absolute;
        bottom: 10px;
        right: 10px;
    }

    .bg-soft-blue {
        background-color: #e3f2fd;
    }
</style>

@code {
    private DateTime CurrentDate = DateTime.Today;
    private DateTime SelectedDate = DateTime.Today;
    private int DaysInMonth = 0;
    private int EmptySlots = 0;
    
    private Dictionary<DateTime, JournalEntry> EntriesByDate = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMonthData();
    }

    private async Task LoadMonthData()
    {
        DaysInMonth = DateTime.DaysInMonth(CurrentDate.Year, CurrentDate.Month);
        var firstDayOfMonth = new DateTime(CurrentDate.Year, CurrentDate.Month, 1);
        EmptySlots = (int)firstDayOfMonth.DayOfWeek;

        var allEntries = await JournalService.GetAllEntriesAsync();
        EntriesByDate = allEntries
            .Where(e => e.Date.Month == CurrentDate.Month && e.Date.Year == CurrentDate.Year)
            .ToDictionary(e => e.Date.Date, e => e);
    }

    private async Task PrevMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);
        await LoadMonthData();
    }

    private async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);
        await LoadMonthData();
    }

    private void SelectDate(DateTime date)
    {
        SelectedDate = date;
    }
    
    private void NavigateToEntry(DateTime date)
    {
        // Ideally pass ID, but for now navigate to entries list or view details
        Navigation.NavigateTo("/entries"); 
    }
}