@page "/entries"
@using DevJournal.Services
@inject JournalEntryService JournalService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold">All Entries</h2>
        <p class="text-muted">Browse and manage your journal entries</p>
    </div>

    <!-- Filters -->
    <div class="card p-3 mb-4 shadow-sm">
        <div class="row g-3">

            <!-- Search -->
            <div class="col-md-12 position-relative">
                <input class="form-control pe-5"
                       placeholder="Search by title or content..."
                       @bind="SearchText"
                       @bind:event="oninput" 
                       @onkeypress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") PerformSearch(); })" />
                <span class="position-absolute top-50 end-0 translate-middle-y me-3 text-muted" role="button" @onclick="PerformSearch" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </span>
            </div>

            <!-- Date Range -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">From Date</label>
                <input type="date" class="form-control" @bind="FromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">To Date</label>
                <input type="date" class="form-control" @bind="ToDate" />
            </div>

            <!-- Mood -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Mood</label>
                <select class="form-select" @bind="SelectedMood">
                    <option value="">All Moods</option>
                    @foreach(var mood in AllMoods)
                    {
                        <option value="@mood">@mood</option>
                    }
                </select>
            </div>

            <!-- Tags -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Tags</label>
                <input class="form-control" placeholder="Search tag..." @bind="SearchTag" @bind:event="oninput" />
            </div>
            
            <div class="col-12 text-end">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear Filters</button>
                <button class="btn btn-primary btn-sm px-4" @onclick="PerformSearch">Apply Filters</button>
            </div>

        </div>
    </div>

    @if (FilteredEntries == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading your memories...</p>
        </div>
    }
    else if (!FilteredEntries.Any())
    {
        <div class="text-center mt-5">
            <p class="text-muted">No entries found.</p>
            <a href="/new-entry" class="btn btn-primary">Create New Entry</a>
        </div>
    }
    else
    {
        @foreach (var entry in FilteredEntries)
        {
            <!-- Entry Card -->
            <div class="card mb-3 shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div style="flex: 1;">
                            <div class="mb-2">
                                <small class="text-muted">@entry.Date.ToString("yyyy-MM-dd")</small>
                                <!-- Primary Mood -->
                                <span class="badge bg-success ms-2">@entry.PrimaryMood</span>
                                
                                <!-- Secondary Moods -->
                                @if (!string.IsNullOrEmpty(entry.SecondaryMoods))
                                {
                                    @foreach(var sm in entry.SecondaryMoods.Split(','))
                                    {
                                        <span class="badge bg-secondary ms-1">@sm</span>
                                    }
                                }

                                <!-- Category -->
                                @if (!string.IsNullOrEmpty(entry.Category))
                                {
                                    <span class="badge bg-info text-dark ms-2">@entry.Category</span>
                                }
                            </div>

                            <h5 class="mt-2 mb-2 fw-bold">@entry.Title</h5>
                            
                            <!-- Content (HTML) -->
                            <div class="entry-content mb-2 text-muted" style="max-height: 150px; overflow: hidden; position: relative;">
                                @((MarkupString)(entry.Content ?? ""))
                                <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 30px; background: linear-gradient(transparent, white);"></div>
                            </div>

                            @if (!string.IsNullOrEmpty(entry.Tags))
                            {
                                <div class="mt-2">
                                    @foreach (var tag in entry.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-light text-dark border me-1">#@tag.Trim()</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="ms-3 d-flex flex-column gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditEntry(entry)">
                                ✏ Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEntry(entry)">
                                🗑 Delete
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        }
    }

</div>


@code {
    private List<JournalEntry>? AllEntries;
    private List<JournalEntry>? FilteredEntries;

    // Filters
    private string SearchText = "";
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string SelectedMood = "";
    private string SearchTag = "";

    // Dropdowns
    private List<string> AllMoods = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }
    
    private async Task LoadEntries()
    {
        AllEntries = await JournalService.GetAllEntriesAsync();
        // Populate unique moods
        AllMoods = AllEntries
                    .Select(e => e.PrimaryMood)
                    .Where(m => !string.IsNullOrEmpty(m))
                    .Distinct()
                    .ToList();
                    
        PerformSearch();
    }

    private void PerformSearch()
    {
        if (AllEntries == null) return;

        var query = AllEntries.AsQueryable();

        // Text
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            query = query.Where(e => (e.Title != null && e.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                                     (e.Content != null && e.Content.Contains(SearchText, StringComparison.OrdinalIgnoreCase)));
        }

        // Date
        if (FromDate.HasValue)
        {
            query = query.Where(e => e.Date >= FromDate.Value);
        }
        if (ToDate.HasValue)
        {
            query = query.Where(e => e.Date <= ToDate.Value);
        }

        // Mood
        if (!string.IsNullOrEmpty(SelectedMood))
        {
            query = query.Where(e => e.PrimaryMood == SelectedMood);
        }

        // Tags
        if (!string.IsNullOrWhiteSpace(SearchTag))
        {
            query = query.Where(e => e.Tags != null && e.Tags.Contains(SearchTag, StringComparison.OrdinalIgnoreCase));
        }

        FilteredEntries = query.OrderByDescending(e => e.Date).ToList();
    }

    private void ClearFilters()
    {
        SearchText = "";
        FromDate = null;
        ToDate = null;
        SelectedMood = "";
        SearchTag = "";
        PerformSearch();
    }

    private void EditEntry(JournalEntry entry)
    {
        Navigation.NavigateTo($"/edit-entry/{entry.Id}");
    }

    private async Task DeleteEntry(JournalEntry entry)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{entry.Title}'?");
        if (confirmed)
        {
            await JournalService.DeleteEntryAsync(entry);
            await LoadEntries(); // Refresh list
        }
    }
}
