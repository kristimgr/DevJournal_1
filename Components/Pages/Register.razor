@page "/register"
@inject DevJournal.Services.AuthService Auth
@inject NavigationManager Nav

<h3>Create Account</h3>
<p>Your personal space for daily reflections</p>

<div style="max-width:420px; border:1px solid #ddd; padding:20px; border-radius:10px;">
    <label>Name</label>
    <input class="form-control" placeholder="Enter your name" @bind="name" />
    @if (!string.IsNullOrEmpty(errName)) { <div style="color:red">@errName</div> }

    <br />

    <label>Password</label>
    <input class="form-control" type="password" placeholder="Minimum 8 characters" @bind="pass" />
    @if (!string.IsNullOrEmpty(errPass)) { <div style="color:red">@errPass</div> }

    <br />

    <label>Confirm Password</label>
    <input class="form-control" type="password" placeholder="Re-enter password" @bind="confirm" />
    @if (!string.IsNullOrEmpty(errConfirm)) { <div style="color:red">@errConfirm</div> }

    <br />

    <button class="btn btn-dark w-100" @onclick="Create">Create Account</button>

    <div style="margin-top:10px;">
        Already have an account? <a href="/login">Unlock Journal</a>
    </div>
</div>

@code {
    string name = "", pass = "", confirm = "";
    string errName = "", errPass = "", errConfirm = "";

    private async Task Create()
    {
        errName = errPass = errConfirm = "";

        if (string.IsNullOrWhiteSpace(name)) errName = "Name is required";
        if (string.IsNullOrWhiteSpace(pass)) errPass = "Password is required";
        else if (pass.Length < 8) errPass = "Minimum 8 characters";
        if (string.IsNullOrWhiteSpace(confirm)) errConfirm = "Please confirm your password";
        else if (pass != confirm) errConfirm = "Passwords do not match";

        if (!string.IsNullOrEmpty(errName) || !string.IsNullOrEmpty(errPass) || !string.IsNullOrEmpty(errConfirm))
            return;

        var (ok, msg) = await Auth.RegisterAsync(name, pass, confirm);

        if (ok)
            Nav.NavigateTo("/login"); // redirect like your figure
        else
            errConfirm = msg;
    }
}
