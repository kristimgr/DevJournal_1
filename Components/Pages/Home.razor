@page "/"

<div class="dashboard">

    <!-- Header -->
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <p>Track your journaling journey</p>
    </div>

    <!-- Stats cards -->
    <div class="stats-grid">

        <div class="stat-card">
            <span class="stat-title">Current Streak</span>
            <h2>0</h2>
            <span class="stat-subtitle">consecutive days</span>
        </div>

        <div class="stat-card">
            <span class="stat-title">Longest Streak</span>
            <h2>0</h2>
            <span class="stat-subtitle">days achieved</span>
        </div>

        <div class="stat-card">
            <span class="stat-title">Missed Days</span>
            <h2>0</h2>
            <span class="stat-subtitle">days without entry</span>
        </div>

    </div>

    <!-- Recent entries -->
    <div class="recent-entries">

        <div class="recent-header">
            <h3>Recent Entries</h3>
            <button class="view-all-btn">View All</button>
        </div>

        <p class="empty-text">No entries yet. Start journaling!</p>

    </div>

</div>


