@page "/"
@using DevJournal
@using DevJournal.Services
@inject JournalEntryService JournalService


<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Dashboard</h1>
        <p class="text-muted">Track your journaling journey</p>
    </div>

    <!-- Stats cards -->
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Total Entries</small>
                    <h2 class="fw-bold">@TotalEntries</h2>
                    <small class="text-muted">saved so far</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Latest Entry</small>
                    <h5 class="fw-bold">@LatestTitle</h5>
                    <small class="text-muted">@LatestDate</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Database Status</small>
                    <h5 class="fw-bold text-success">Connected</h5>
                    <small class="text-muted">SQLite OK</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent entries -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Recent Entries</h5>
                <button class="btn btn-outline-primary btn-sm" @onclick="LoadEntries">
                    🔄 Test Database
                </button>
            </div>

            @if (Entries == null)
            {
                <p class="text-muted mb-0">
                    Click <b>Test Database</b> to check if entries are saved.
                </p>
            }
            else if (Entries.Count == 0)
            {
                <p class="text-danger mb-0">
                    ❌ No entries found in database
                </p>
            }
            else
            {
                <p class="text-success mb-2">
                    ✅ Total Entries: <b>@Entries.Count</b>
                </p>

                <ul class="list-group">
                    @foreach (var entry in Entries.Take(5))
                    {
                        <li class="list-group-item">
                            <b>@entry.Date.ToShortDateString()</b> — @entry.Title
                        </li>
                    }
                </ul>
            }

        </div>
    </div>

</div>

@code {

    private List<JournalEntry>? Entries;
    private int TotalEntries = 0;
    private string LatestTitle = "—";
    private string LatestDate = "—";

    private async Task LoadEntries()
    {
        Entries = await JournalService.GetAllEntriesAsync();

        TotalEntries = Entries.Count;

        if (Entries.Count > 0)
        {
            var latest = Entries
                .OrderByDescending(e => e.Date)
                .First();

            LatestTitle = latest.Title;
            LatestDate = latest.Date.ToString("dddd, MMM dd yyyy");
        }
        else
        {
            LatestTitle = "No entries";
            LatestDate = "—";
        }

        StateHasChanged();
    }
}
